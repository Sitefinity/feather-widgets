@using Telerik.Sitefinity.Services
@model Telerik.Sitefinity.Frontend.Assistant.Mvc.Models.SitefinityAssistantViewModel

<link href="@Model.GetCdnUrl("sf-assistant-chat-widget.css")" rel="stylesheet" type="text/css">
<script src="@Model.GetCdnUrl("jquery.min.js")" type="text/javascript"></script>
<script src="@Model.GetCdnUrl("marked.min.js")" type="text/javascript"></script>
<script src="@Model.GetCdnUrl("sf-assistant-chat.js")" type="text/javascript"></script>
<script src="@Model.GetCdnUrl("azure-assistant-chat-service.js")" type="text/javascript"></script>

@if (SystemManager.IsDesignMode && !string.IsNullOrEmpty(Model.AssistantApiKey) && Model.DisplayMode.ToString() == "modal")
{
    <div style="border: 1px dashed #ccc; height: 10px; width: 100%; font-size: 0px;">###placeholder###</div>
}

@if (!string.IsNullOrEmpty(Model.CustomCss))
{
    <link rel="stylesheet" type="text/css" href="@Model.CustomCss" />
}

@if (Model.DisplayMode.ToString() == "inline")
{
    <div id="@Model.ContainerId"
         class="@Model.CssClass">
    </div>
}

<script>
    var chatSettings = {
        bot: {
            name: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.AssistantDisplayName))',
            avatarUrl: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.AssistantAvatarUrl))'
        },
        input: {
            supportsMultilineText: true,
            placeholder: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Placeholder))'
        },
        notice: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.Notice))',
        service: new AzureAssistantChatService({
            serviceType: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ChatServiceName))',
            greetingsMessage: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.AssistantGreetingMessage))',
            endpoint: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ServiceUrl))',
            assistantApiKey: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.AssistantApiKey))'
        }, marked.parse),
        css: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.CustomCss))'
    };

    var display = {
        id: 'sf-assistant-chat',
        display: {
            mode: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.DisplayMode.ToString()))',
            launcher: {
                openIconUrl: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.OpeningChatIconUrl))',
                closeIconUrl: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ClosingChatIconUrl))'
            },
            containerId: '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.ContainerId))'
        },
        chat: chatSettings
    };

    initChat();

    function initChat() {
        SFAssistantChat.load(display);
    }
</script>